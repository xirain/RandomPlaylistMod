<?xml version="1.0" encoding="utf-8"?>
<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
    <vertical child-control-height='true' child-expand-height='false' spacing="1">
        <horizontal spacing="5">
            <text text="Min:" font-size="4"/>
            <increment-setting value="selected-duration" min="15" max="120" increment="15" integer-only="true" pref-width="80"/>
            <button text="Start" on-click="start-session" pref-width="70"/>
            <button text="End" on-click="end-session" pref-width="70"/>
        </horizontal>

        <horizontal spacing="5">
            <text text="BPM:" font-size="4"/>
            <increment-setting value="min-bpm" min="0" max="300" increment="10" integer-only="true" pref-width="60"/>
            <text text="-" font-size="4"/>
            <increment-setting value="max-bpm" min="0" max="500" increment="10" integer-only="true" pref-width="60"/>
        </horizontal>

        <text text="{session-status}" font-size="3" align="Center" word-wrap="true"/>

        <horizontal spacing="10">
            <text text="{selected-info}" font-size="3" align="Left"/>
            <text text="{estimated-info}" font-size="3" align="Right"/>
        </horizontal>

        <horizontal>
            <text text="Playlists" font-size="4"/>
            <button text="All" on-click="select-all" pref-width="40"/>
            <button text="None" on-click="deselect-all" pref-width="40"/>
        </horizontal>

        <list id="playlist-list" list-style='List' select-cell='on-playlist-click' preferred-height="55" min-height="30"/>
    </vertical>
</bg>
