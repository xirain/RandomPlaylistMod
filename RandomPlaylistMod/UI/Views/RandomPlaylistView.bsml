<?xml version="1.0" encoding="utf-8"?>
<vertical anchor-pos-x="0" preferred-width="120" child-control-height="false" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd">
    <vertical child-control-height='true' child-expand-height='false' spacing="2">

        <!-- Row 1: Duration + session controls -->
        <vertical horizontal-fit="Unconstrained" child-control-height="false" child-expand-height="false"
                  bg="round-rect-panel" bg-color="#00000077" pad="1" pad-left="2" pad-right="2">
            <horizontal spacing="3">
                <increment-setting text="Duration" value="selected-duration" min="15" max="120" increment="15" integer-only="true" apply-on-change="true" on-change="on-duration-change"/>
                <button text="Start" on-click="start-session" pref-width="60"/>
                <button text="End" on-click="end-session" pref-width="60"/>
            </horizontal>
        </vertical>

        <!-- Row 2: NPS filter (Notes Per Second, from SongDetailsCache) -->
        <vertical horizontal-fit="Unconstrained" child-control-height="false" child-expand-height="false"
                  bg="round-rect-panel" bg-color="#00000077" pad="1" pad-left="2" pad-right="2">
            <horizontal spacing="1">
                <text text="NPS" font-size="4"/>
                <button text="Any" on-click="nps-any" pref-width="30"/>
                <button text="3-8" on-click="nps-38" pref-width="30"/>
                <button text="8+" on-click="nps-8plus" pref-width="30"/>
            </horizontal>
        </vertical>

        <!-- Row 2.5: AutoBS feature mode (借已装 AutoBS 模组增强/生成) -->
        <vertical horizontal-fit="Unconstrained" child-control-height="false" child-expand-height="false"
                  bg="round-rect-panel" bg-color="#00000077" pad="1" pad-left="2" pad-right="2">
            <horizontal spacing="1">
                <text text="AutoBS" font-size="4"/>
                <button text="Standard" on-click="abs-standard" pref-width="38"/>
                <button text="45°" on-click="abs-45" pref-width="28"/>
                <button text="60°" on-click="abs-60" pref-width="28"/>
                <button text="90°" on-click="abs-90" pref-width="28"/>
                <button text="360°" on-click="abs-360" pref-width="34"/>
            </horizontal>
        </vertical>

        <!-- Row 3: gameplay settings -->
        <vertical horizontal-fit="Unconstrained" child-control-height="false" child-expand-height="false"
                  bg="round-rect-panel" bg-color="#00000077" pad="1" pad-left="2" pad-right="2">
            <horizontal spacing="3">
                <text text="Gameplay" font-size="4"/>
                <button text="~no-fail-button-text" on-click="toggle-no-fail" pref-width="55"/>
                <button text="~hud-button-text" on-click="toggle-hud" pref-width="55"/>
            </horizontal>
        </vertical>

        <!-- Row 4: session status -->
        <text text="{session-status}" font-size="3" align="Center" word-wrap="true"/>
        <horizontal spacing="10">
            <text text="{selected-info}" font-size="3" align="Left"/>
            <text text="{estimated-info}" font-size="3" align="Right"/>
        </horizontal>

        <!-- Row 5: playlist header -->
        <horizontal>
            <text text="Playlists" font-size="4"/>
            <text text="~selected-playlist-count-text" font-size="3" align="Center"/>
            <button text="All" on-click="select-all" pref-width="40"/>
            <button text="None" on-click="deselect-all" pref-width="40"/>
        </horizontal>

        <list id="playlist-list" list-style='List' select-cell='on-playlist-click' preferred-height="65" min-height="40"/>
    </vertical>
</vertical>
